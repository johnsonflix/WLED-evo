{
  "name": "EvoLightsCloudRelay",
  "build": {
    "libArchive": false,
    "srcFilter": [
      "+<*.cpp>",
      "+<*.c>",
      "+<vendor/WiFiClientSecure/*.cpp>",
      "+<vendor/WiFiClientSecure/*.c>"
    ],
    "includeDir": ".",
    "flags": [
      "-I./vendor/WiFiClientSecure",
      "-DMBEDTLS_KEY_EXCHANGE_SOME_PSK_ENABLED",
      "-DMBEDTLS_KEY_EXCHANGE__SOME__PSK_ENABLED"
    ]
  },
  "dependencies": {
    "knolleary/PubSubClient": "^2.8"
  }
}
